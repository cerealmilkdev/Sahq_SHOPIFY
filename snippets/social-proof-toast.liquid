{% comment %}
  Social Proof Toast — "X vient d'acheter ce produit"
  Rendered globally in layout/theme.liquid before </body>
  Configurable via section settings on any section or directly here.
{% endcomment %}

{% assign sp_enabled = settings.sp_toast_enabled | default: true %}
{% if sp_enabled %}

<div class="sp-toast" id="sp-toast" role="status" aria-live="polite" aria-atomic="true" style="display:none;">
  <button class="sp-toast__close" id="sp-toast-close" aria-label="Fermer">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <div class="sp-toast__inner">
    <div class="sp-toast__image-wrap" id="sp-toast-img-wrap">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" class="sp-toast__img" id="sp-toast-img" width="50" height="50">
      {% else %}
        <div class="sp-toast__img-placeholder" id="sp-toast-img">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9l4-4 4 4 4-4 4 4"/>
          </svg>
        </div>
      {% endif %}
    </div>
    <div class="sp-toast__body">
      <p class="sp-toast__name" id="sp-toast-name"></p>
      <p class="sp-toast__product" id="sp-toast-product"></p>
      <p class="sp-toast__time" id="sp-toast-time"></p>
    </div>
  </div>
</div>

<style>
  .sp-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 9999;
    max-width: 320px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.14), 0 2px 8px rgba(0,0,0,0.08);
    padding: 0.875rem 1rem;
    border: 1px solid rgba(0,0,0,0.06);
    animation: sp-slideIn 0.4s cubic-bezier(0.34,1.56,0.64,1) forwards;
    cursor: pointer;
  }

  .sp-toast.sp-hiding {
    animation: sp-slideOut 0.3s ease forwards;
  }

  @keyframes sp-slideIn {
    from { transform: translateX(-110%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
  }

  @keyframes sp-slideOut {
    from { transform: translateX(0);    opacity: 1; }
    to   { transform: translateX(-110%); opacity: 0; }
  }

  .sp-toast__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sp-toast__close {
    position: absolute;
    top: 0.1rem;
    right: 0.1rem;
    width: 20px;
    height: 20px;
    border: none;
    background: transparent;  
    cursor: pointer;
    color: #999;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s ease, color 0.2s ease;
    padding: 0;
  }

  .sp-toast__close:hover {
    background: rgba(0,0,0,0.07);
    color: #333;
  }

  .sp-toast__image-wrap {
    flex-shrink: 0;
  }

  .sp-toast__img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .sp-toast__img-placeholder {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #667eea20, #764ba220);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #667eea;
  }

  .sp-toast__body {
    flex: 1;
    min-width: 0;
  }

  .sp-toast__name {
    font-size: 0.8rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 0.1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sp-toast__product {
    font-size: 0.78rem;
    color: #444;
    margin: 0 0 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sp-toast__time {
    font-size: 0.72rem;
    color: #888;
    margin: 0;
  }

  @media (max-width: 480px) {
    .sp-toast {
      left: 0.75rem;
      right: 0.75rem;
      max-width: none;
      bottom: 1rem;
    }
  }
</style>

<script>
(function() {
  var TOAST_SESSION_KEY = 'sp_toast_dismissed';
  if (sessionStorage.getItem(TOAST_SESSION_KEY)) return;

  var names = {{ settings.sp_toast_names | default: '"Sophie de Lyon\nLucas de Paris\nEmma de Bordeaux\nNoa de Marseille\nThéo de Lyon\nClara de Nantes\nMaxime de Toulouse\nLéa de Strasbourg"' | newline_to_br | split: '<br />' | json }};
  var productTitle = {{ product.title | default: settings.sp_toast_product_title | default: 'ce produit' | json }};
  var productUrl = {{ product.url | default: '#' | json }};
  var firstDelay = {{ settings.sp_toast_first_delay | default: 8 }} * 1000;
  var interval   = {{ settings.sp_toast_interval    | default: 20 }} * 1000;
  var displayDuration = 5000;

  var toast     = document.getElementById('sp-toast');
  var nameEl    = document.getElementById('sp-toast-name');
  var productEl = document.getElementById('sp-toast-product');
  var timeEl    = document.getElementById('sp-toast-time');
  var closeBtn  = document.getElementById('sp-toast-close');

  if (!toast || !names || names.length === 0) return;

  // Clean up names array (remove empty strings from split)
  names = names.filter(function(n){ return n && n.trim() !== ''; });
  if (names.length === 0) return;

  var idx = 0;
  var hideTimer, showTimer;

  function getRandomMinutes() {
    return Math.floor(Math.random() * 55) + 1;
  }

  function showToast() {
    if (sessionStorage.getItem(TOAST_SESSION_KEY)) return;

    var person = names[idx % names.length].trim();
    idx++;

    nameEl.textContent    = person;
    productEl.textContent = productTitle;
    timeEl.textContent    = 'il y a ' + getRandomMinutes() + ' min';

    toast.classList.remove('sp-hiding');
    toast.style.display = 'block';

    clearTimeout(hideTimer);
    hideTimer = setTimeout(hideToast, displayDuration);
  }

  function hideToast() {
    toast.classList.add('sp-hiding');
    setTimeout(function() {
      toast.style.display = 'none';
      toast.classList.remove('sp-hiding');
    }, 320);
  }

  function dismiss() {
    clearTimeout(hideTimer);
    clearTimeout(showTimer);
    hideToast();
    sessionStorage.setItem(TOAST_SESSION_KEY, '1');
  }

  closeBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    dismiss();
  });

  toast.addEventListener('click', function() {
    if (productUrl && productUrl !== '#') {
      window.location.href = productUrl;
    }
  });

  // Start sequence
  showTimer = setTimeout(function loop() {
    showToast();
    showTimer = setTimeout(loop, interval);
  }, firstDelay);
})();
</script>

{% endif %}
