{% comment %}
  Frequently Bought Together
  Place on the product template via the customizer.
  Select up to 3 companion products via product_picker blocks.
{% endcomment %}

{% assign fbt_products = '' | split: '' %}
{% for block in section.blocks %}
  {% if block.settings.product != blank %}
    {% assign fbt_products = fbt_products | concat: block.settings.product %}
  {% endif %}
{% endfor %}

{% if fbt_products.size > 0 %}
<div class="fbt-section section-{{ section.id }}">
  <div class="fbt-container">
    {% if section.settings.badge_text != blank %}
      <div class="fbt-badge">{{ section.settings.badge_text }}</div>
    {% endif %}

    {% if section.settings.title != blank %}
      <h3 class="fbt-title">{{ section.settings.title }}</h3>
    {% endif %}

    <div class="fbt-products" id="fbt-products-{{ section.id }}">
      <!-- Main product -->
      <div class="fbt-product" data-fbt-product data-price="{{ product.selected_or_first_available_variant.price }}" data-id="{{ product.selected_or_first_available_variant.id }}">
        <label class="fbt-product__checkbox-wrap">
          <input type="checkbox" class="fbt-cb" checked disabled>
        </label>
        <div class="fbt-product__image">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" width="80" height="80" loading="lazy">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'fbt-placeholder' }}
          {% endif %}
        </div>
        <div class="fbt-product__info">
          <p class="fbt-product__title">{{ product.title }}</p>
          <p class="fbt-product__price">{{ product.selected_or_first_available_variant.price | money }}</p>
        </div>
      </div>

      <!-- Companion products -->
      {% for block in section.blocks %}
        {% assign companion = block.settings.product %}
        {% if companion != blank %}
          <div class="fbt-sep" aria-hidden="true">+</div>
          <div class="fbt-product" data-fbt-product data-price="{{ companion.selected_or_first_available_variant.price }}" data-id="{{ companion.selected_or_first_available_variant.id }}" {{ block.shopify_attributes }}>
            <label class="fbt-product__checkbox-wrap">
              <input type="checkbox" class="fbt-cb" checked>
            </label>
            <div class="fbt-product__image">
              {% if companion.featured_image %}
                <img src="{{ companion.featured_image | image_url: width: 200 }}" alt="{{ companion.title | escape }}" width="80" height="80" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'fbt-placeholder' }}
              {% endif %}
            </div>
            <div class="fbt-product__info">
              <a href="{{ companion.url }}" class="fbt-product__title">{{ companion.title }}</a>
              <p class="fbt-product__price">{{ companion.selected_or_first_available_variant.price | money }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="fbt-footer">
      <div class="fbt-total-wrap">
        <span class="fbt-total-label">{{ section.settings.total_label | default: 'Total :' }}</span>
        <span class="fbt-total" id="fbt-total-{{ section.id }}">—</span>
      </div>
      <button type="button" class="fbt-btn" id="fbt-btn-{{ section.id }}" data-fbt-btn>
        🛒 {{ section.settings.cta_text | default: 'Ajouter tout au panier' }}
      </button>
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .fbt-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .fbt-badge {
    display: inline-block;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 50px;
    margin-bottom: 0.75rem;
  }

  .fbt-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0 0 1.25rem;
  }

  .fbt-products {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    padding: 1.25rem;
    border-radius: 14px;
  }

  .fbt-product {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 180px;
  }

  .fbt-product__checkbox-wrap input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: #667eea;
  }

  .fbt-product__image {
    width: 70px;
    height: 70px;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    flex-shrink: 0;
  }

  .fbt-product__image img,
  .fbt-product__image .fbt-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fbt-product__info {
    flex: 1;
    min-width: 0;
  }

  .fbt-product__title {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0 0 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    display: block;
  }

  .fbt-product__price {
    font-size: 0.9rem;
    font-weight: 700;
    color: #667eea;
    margin: 0;
  }

  .fbt-sep {
    font-size: 1.5rem;
    font-weight: 700;
    color: #667eea;
    flex-shrink: 0;
  }

  .fbt-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .fbt-total-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .fbt-total-label {
    font-size: 0.85rem;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  .fbt-total {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-foreground);
  }

  .fbt-btn {
    flex: 1;
    min-width: 220px;
    padding: 0.875rem 1.5rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(102,126,234,0.3);
  }

  .fbt-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(102,126,234,0.4);
  }

  .fbt-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  @media (max-width: 600px) {
    .fbt-products {
      flex-direction: column;
    }
    .fbt-sep {
      transform: rotate(90deg);
    }
    .fbt-product {
      width: 100%;
    }
  }
</style>

<script>
(function() {
  var sectionId = {{ section.id | json }};
  var totalEl = document.getElementById('fbt-total-' + sectionId);
  var btn     = document.getElementById('fbt-btn-' + sectionId);

  if (!totalEl || !btn) return;

  function formatMoney(cents) {
    if (window.Shopify && window.Shopify.money_format) {
      var fmt = window.Shopify.money_format;
      return fmt.replace(/\{\{\s*amount\s*\}\}/, (cents / 100).toFixed(2))
                .replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(cents / 100));
    }
    return (cents / 100).toFixed(2) + ' €';
  }

  function updateTotal() {
    var total = 0;
    document.querySelectorAll('[data-fbt-product]').forEach(function(p) {
      var cb = p.querySelector('.fbt-cb');
      if (!cb || cb.checked) {
        total += parseInt(p.dataset.price) || 0;
      }
    });
    totalEl.textContent = formatMoney(total);
  }

  document.querySelectorAll('[data-fbt-product] .fbt-cb').forEach(function(cb) {
    cb.addEventListener('change', updateTotal);
  });

  btn.addEventListener('click', function() {
    var items = [];
    document.querySelectorAll('[data-fbt-product]').forEach(function(p) {
      var cb = p.querySelector('.fbt-cb');
      if (!cb || cb.checked) {
        var id = parseInt(p.dataset.id);
        if (id) items.push({ id: id, quantity: 1 });
      }
    });

    if (!items.length) return;

    btn.disabled = true;
    btn.textContent = '⏳ Ajout en cours…';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      btn.textContent = '✓ Ajouté !';
      // Open cart drawer if CartDrawer global exists
      if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
        window.CartDrawer.open();
      } else {
        // Dispatch event for theme.js to catch
        document.dispatchEvent(new CustomEvent('cart:open'));
      }
      setTimeout(function() {
        btn.disabled = false;
        btn.textContent = '🛒 {{ section.settings.cta_text | default: 'Ajouter tout au panier' | escape }}';
      }, 2000);
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = '⚠️ Erreur – réessayez';
      setTimeout(function() {
        btn.textContent = '🛒 {{ section.settings.cta_text | default: 'Ajouter tout au panier' | escape }}';
      }, 2500);
    });
  });

  updateTotal();
})();
</script>

{% endif %}

{% schema %}
{
  "name": "Achat groupé",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texte du badge",
      "default": "Souvent achetés ensemble"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Complétez votre achat"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Libellé total",
      "default": "Total :"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte bouton",
      "default": "Ajouter tout au panier"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espace haut",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espace bas",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit complémentaire",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Achat groupé"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
