{% comment %}
  USP Bar — Configurable icons + text for key selling points.
  Supports: auto-rotation of messages, inline countdown, dismissible with cookie.
  Place under header or above footer.
{% endcomment %}

{% assign usp_dismissed = false %}

{% if section.blocks.size > 0 %}
  <div
    class="usp-bar full-width"
    id="usp-bar-{{ section.id }}"
    style="
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {% if section.settings.dismissible %}
      <button class="usp-bar__dismiss" id="usp-bar-dismiss-{{ section.id }}" aria-label="Fermer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    {% endif %}

    <div class="usp-bar__container">
      {% if section.settings.rotation_enabled %}
        {% comment %} Rotation mode: show one item at a time {% endcomment %}
        <div class="usp-bar__rotator" id="usp-rotator-{{ section.id }}">
          {% for block in section.blocks %}
            <div class="usp-bar__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
              {% assign item_link = block.settings.link %}
              {% if item_link != blank %}<a href="{{ item_link }}" class="usp-bar__link">{% endif %}
                {% if block.settings.icon != blank %}
                  <span class="usp-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {% endif %}
                <span class="usp-bar__text">
                  {{ block.settings.text }}
                  {% if block.settings.show_countdown and block.settings.countdown_end != blank %}
                    <span class="usp-countdown" data-countdown-end="{{ block.settings.countdown_end | date: '%Y-%m-%dT%H:%M:%S' }}">
                      <span data-cd-h>00</span>h <span data-cd-m>00</span>m <span data-cd-s>00</span>s
                    </span>
                  {% endif %}
                </span>
              {% if item_link != blank %}</a>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        {% comment %} Standard list mode {% endcomment %}
        <ul class="usp-bar__list" role="list">
          {% for block in section.blocks %}
            <li class="usp-bar__item" {{ block.shopify_attributes }}>
              {% assign item_link = block.settings.link %}
              {% if item_link != blank %}<a href="{{ item_link }}" class="usp-bar__link">{% endif %}
                {% if block.settings.icon != blank %}
                  <span class="usp-bar__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {% endif %}
                <div class="usp-bar__text-group">
                  {% if block.settings.text != blank %}
                    <span class="usp-bar__text">{{ block.settings.text }}</span>
                  {% endif %}
                  {% if block.settings.subtext != blank %}
                    <span class="usp-bar__subtext">{{ block.settings.subtext }}</span>
                  {% endif %}
                </div>
              {% if item_link != blank %}</a>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .usp-bar {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    position: relative;
    transition: opacity 0.3s ease;
  }

  .usp-bar.is-hidden {
    display: none;
  }

  .usp-bar__dismiss {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    color: currentColor;
    opacity: 0.5;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: opacity 0.2s ease;
    z-index: 5;
  }

  .usp-bar__dismiss:hover { opacity: 1; }

  .usp-bar__container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .usp-bar__container::-webkit-scrollbar {
    display: none;
  }

  .usp-bar__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: max-content;
  }

  .usp-bar__item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .usp-bar__icon {
    font-size: 1.375rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .usp-bar__text-group {
    display: flex;
    flex-direction: column;
  }

  .usp-bar__text {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .usp-bar__subtext {
    font-size: 0.75rem;
    opacity: 0.65;
    white-space: nowrap;
  }

  .usp-bar__link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .usp-bar__link:hover { opacity: 0.8; }

  /* Rotator mode */
  .usp-bar__rotator {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2em;
    position: relative;
    overflow: hidden;
  }

  .usp-bar__slide {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    animation: usp-fadein 0.4s ease;
  }

  .usp-bar__slide.is-active { display: flex; }

  @keyframes usp-fadein {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Inline countdown */
  .usp-countdown {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    background: rgba(255,255,255,0.2);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.82rem;
  }

  @media (max-width: 768px) {
    .usp-bar__list {
      justify-content: flex-start;
      gap: 1.5rem;
    }
  }
{% endstylesheet %}

<script>
(function() {
  var sectionId  = {{ section.id | json }};
  var barEl      = document.getElementById('usp-bar-' + sectionId);
  var dismissBtn = document.getElementById('usp-bar-dismiss-' + sectionId);
  var rotator    = document.getElementById('usp-rotator-' + sectionId);

  if (!barEl) return;

  // Dismiss with 24h cookie
  var DISMISS_KEY = 'usp_dismissed_' + sectionId;
  if (localStorage.getItem(DISMISS_KEY)) {
    barEl.style.display = 'none';
    return;
  }

  if (dismissBtn) {
    dismissBtn.addEventListener('click', function() {
      barEl.style.display = 'none';
      try { localStorage.setItem(DISMISS_KEY, Date.now() + 86400000); } catch(e) {}
    });
  }

  // Auto-rotation
  if (rotator) {
    var slides  = Array.from(rotator.querySelectorAll('.usp-bar__slide'));
    var current = 0;
    var interval = {{ section.settings.rotation_interval | default: 4 }} * 1000;

    if (slides.length > 1) {
      setInterval(function() {
        slides[current].classList.remove('is-active');
        current = (current + 1) % slides.length;
        slides[current].classList.add('is-active');
      }, interval);
    }
  }

  // Countdown timers
  document.querySelectorAll('[data-countdown-end]').forEach(function(el) {
    var end  = new Date(el.dataset.countdownEnd).getTime();
    var hEl  = el.querySelector('[data-cd-h]');
    var mEl  = el.querySelector('[data-cd-m]');
    var sEl  = el.querySelector('[data-cd-s]');

    function tick() {
      var now  = Date.now();
      var diff = Math.max(0, end - now);
      var h    = Math.floor(diff / 3600000);
      var m    = Math.floor((diff % 3600000) / 60000);
      var s    = Math.floor((diff % 60000) / 1000);
      if (hEl) hEl.textContent = String(h).padStart(2, '0');
      if (mEl) mEl.textContent = String(m).padStart(2, '0');
      if (sEl) sEl.textContent = String(s).padStart(2, '0');
      if (diff > 0) requestAnimationFrame(function() { setTimeout(tick, 1000); });
    }
    tick();
  });
})();
</script>

{% schema %}
{
  "name": "USP BAR",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Rotation"
    },
    {
      "type": "checkbox",
      "id": "rotation_enabled",
      "label": "Activer la rotation des messages",
      "default": false
    },
    {
      "type": "range",
      "id": "rotation_interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Intervalle de rotation",
      "default": 4
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Dismissible (bouton fermer)",
      "default": false
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.usp_bar.settings.bg_color.label",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.usp_bar.settings.text_color.label",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.usp_bar.settings.padding_top.label",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.usp_bar.settings.padding_bottom.label",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.usp_bar.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "t:sections.usp_bar.blocks.item.settings.icon.label",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.usp_bar.blocks.item.settings.text.label",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "t:sections.usp_bar.blocks.item.settings.subtext.label",
          "default": "On orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (optionnel)"
        },
        {
          "type": "checkbox",
          "id": "show_countdown",
          "label": "Afficher un countdown inline",
          "default": false
        },
        {
          "type": "text",
          "id": "countdown_end",
          "label": "Date de fin countdown",
          "placeholder": "2025-12-31T23:59:59"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.usp_bar.presets.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "🚚",
            "text": "Free Shipping",
            "subtext": "On orders over $50"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "↩️",
            "text": "Easy Returns",
            "subtext": "30-day return policy"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "🔒",
            "text": "Secure Payment",
            "subtext": "SSL encrypted checkout"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "💬",
            "text": "24/7 Support",
            "subtext": "We're here to help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
