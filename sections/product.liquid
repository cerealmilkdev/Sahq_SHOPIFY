{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-page">
  <div class="product-container">
    <!-- Product Images -->
    <div class="product-images">
      {% for image in product.images %}
        <div class="product-image-wrapper">
          {% render 'image', 
            class: 'product-image', 
            image: image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        </div>
      {% endfor %}
    </div>

    <!-- Product Info -->
    <div class="product-info">
      <h1 class="product-title">{{ product.title }}</h1>
      <div class="product-price">{{ product.price | money }}</div>
      <div class="product-description">{{ product.description }}</div>
    </div>

    <!-- Product Form -->
    <div class="product-form">
      {% form 'product', product %}
        {% assign current_variant = product.selected_or_first_available_variant %}

        {% if product.variants.size > 1 %}
          <div class="form-group">
            <label class="form-label">{{ 'product.variant_label' | t }}</label>

            {% comment %} Hidden real select (kept for form submission) {% endcomment %}
            <select name="id" id="variant-select" class="form-select" style="display:none;" aria-hidden="true">
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-available="{{ variant.available }}"
                  {% if variant == current_variant %}selected="selected"{% endif %}
                >
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>

            {% comment %} Swatch UI {% endcomment %}
            {% for option in product.options_with_values %}
              <div class="swatch-group" data-option-index="{{ forloop.index0 }}">
                <span class="swatch-group__label">
                  {{ option.name }}:
                  <span class="swatch-group__selected" id="swatch-val-{{ forloop.index0 }}">
                    {{ option.selected_value }}
                  </span>
                </span>
                <div class="swatch-list">
                  {% assign opt_name_lower = option.name | downcase %}
                  {% for value in option.values %}
                    {% assign value_lower = value | downcase %}
                    {% comment %} Check availability {% endcomment %}
                    {% assign is_available = false %}
                    {% for variant in product.variants %}
                      {% if variant.option1 == value or variant.option2 == value or variant.option3 == value %}
                        {% if variant.available %}{% assign is_available = true %}{% endif %}
                      {% endif %}
                    {% endfor %}

                    {% if opt_name_lower == 'couleur' or opt_name_lower == 'color' or opt_name_lower == 'colour' %}
                      <button
                        type="button"
                        class="swatch swatch--color {% if value == option.selected_value %}is-selected{% endif %} {% unless is_available %}is-unavailable{% endunless %}"
                        data-swatch-value="{{ value | escape }}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        title="{{ value | escape }}"
                        aria-label="{{ value | escape }}"
                        style="background-color: {{ value | downcase | replace: ' ', '' }};"
                      ></button>
                    {% else %}
                      <button
                        type="button"
                        class="swatch swatch--label {% if value == option.selected_value %}is-selected{% endif %} {% unless is_available %}is-unavailable{% endunless %}"
                        data-swatch-value="{{ value | escape }}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        aria-label="{{ value | escape }}"
                      >
                        {{ value }}
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        <div class="form-group">
          <label for="quantity" class="form-label">{{ 'product.quantity_label' | t }}</label>
          <input 
            type="number" 
            name="quantity" 
            id="quantity"
            min="1" 
            value="1"
            class="form-input"
          >
        </div>

        {% assign current_variant = product.selected_or_first_available_variant %}

        {% if section.settings.show_urgency_signals %}
          {% if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold %}
            <div class="product-urgency product-urgency--stock">
              <span class="urgency-icon">⚠️</span>
              <span>{{ 'product.low_stock' | t: count: current_variant.inventory_quantity }}</span>
            </div>
          {% endif %}

          {% assign viewers_count = section.settings.min_viewers | plus: 0 %}
          <div class="product-urgency product-urgency--viewers" data-viewers
            data-min="{{ section.settings.min_viewers }}"
            data-max="{{ section.settings.max_viewers }}">
            <span class="urgency-icon">🔥</span>
            <span data-viewers-text>{{ 'product.viewers_count' | t: count: viewers_count }}</span>
          </div>
        {% endif %}

        {% comment %} Back-in-Stock Form (auto shown if variant unavailable) {% endcomment %}
        {% render 'back-in-stock', variant: current_variant %}

        <div class="form-actions" {% unless current_variant.available %}style="display:none;"{% endunless %} id="product-form-actions">
          <button type="submit" class="btn btn-primary" data-add-to-cart
            data-text-default="{{ 'product.add_to_cart' | t }}"
            data-text-adding="{{ 'product.adding_to_cart' | t }}"
            data-text-sold-out="{{ 'product.sold_out' | t }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span class="btn-text">
              {%- if current_variant.available -%}
                {{ 'product.add_to_cart' | t }}
              {%- else -%}
                {{ 'product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="btn-icon">🛒</span>
          </button>
          {% if current_variant.available %}{{ form | payment_button }}{% endif %}
        </div>

        {% if section.settings.show_trust_badges %}
          <div class="product-trust-badges">
            <div class="trust-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>{{ 'product.trust_secure' | t }}</span>
            </div>
            <div class="trust-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 6v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>{{ 'product.trust_delivery' | t }}</span>
            </div>
            <div class="trust-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
              <span>{{ 'product.trust_returns' | t }}</span>
            </div>
            <div class="trust-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              <span>{{ 'product.trust_guarantee' | t }}</span>
            </div>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% if section.settings.show_sticky_atc %}
  {% assign sticky_variant = product.selected_or_first_available_variant %}
  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    <div class="sticky-atc__container">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 80 }}"
          alt="{{ product.title | escape }}"
          class="sticky-atc__image"
          width="40"
          height="40"
          loading="lazy"
        >
      {% endif %}
      <div class="sticky-atc__info">
        <span class="sticky-atc__title">{{ product.title }}</span>
        <span class="sticky-atc__price">{{ sticky_variant.price | money }}</span>
      </div>
      <button type="button" class="sticky-atc__btn btn btn-primary" data-sticky-atc-btn>
        {{ 'product.add_to_cart' | t }}
      </button>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .product-page {
    padding: 2rem 0;
    min-height: 80vh;
  }

  .product-container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Product Images */
  .product-images {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product-image-wrapper {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .product-image-wrapper:hover {
    transform: scale(1.02);
  }

  .product-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Product Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .product-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.2;
  }

  .product-price {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 0.5rem 0;
  }

  .product-description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-foreground);
    opacity: 0.8;
  }

  /* Product Form */
  .product-form {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-foreground);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-select,
  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    font-size: 1rem;
    background: white;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .form-select:focus,
  .form-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  }

  .btn-icon {
    font-size: 1.1rem;
  }

  /* Payment Button Styling */
  .product-form .shopify-payment-button {
    margin-top: 1rem;
  }

  .product-form .shopify-payment-button__button {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%) !important;
    border-radius: 8px !important;
    font-weight: 600 !important;
    padding: 1rem 2rem !important;
    transition: all 0.3s ease !important;
  }

  .product-form .shopify-payment-button__button:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4) !important;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .product-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .product-page {
      padding: 1rem 0;
    }

    .product-container {
      padding: 0 1rem;
    }

    .product-title {
      font-size: 1.75rem;
    }

    .product-form {
      padding: 1.5rem;
    }

    .btn {
      padding: 0.875rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .product-title {
      font-size: 1.5rem;
    }

    .product-price {
      font-size: 1.5rem;
    }

    .product-form {
      padding: 1rem;
    }
  }

  /* Loading States */
  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  /* Animation for form submission */
  .form-submitting .btn-text {
    opacity: 0.7;
  }

  .form-submitting .btn-icon {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Urgency signals */
  .product-urgency {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .product-urgency--stock {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffc107;
  }

  .product-urgency--viewers {
    background: #fff0f0;
    color: #c0392b;
    border: 1px solid #e74c3c;
  }

  .urgency-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* Trust badges */
  .product-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-foreground);
    opacity: 0.75;
  }

  .trust-badge svg {
    flex-shrink: 0;
    color: var(--color-accent);
    opacity: 1;
  }

  /* Sticky ATC bar */
  .sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 150;
    background: white;
    border-top: 1px solid rgba(0,0,0,0.1);
    box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .sticky-atc.is-visible {
    transform: translateY(0);
  }

  .sticky-atc__container {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0.75rem var(--page-margin);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .sticky-atc__image {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .sticky-atc__info {
    flex: 1;
    min-width: 0;
  }

  .sticky-atc__title {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-atc__price {
    display: block;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .sticky-atc__btn {
    flex-shrink: 0;
    padding: 0.625rem 1.5rem;
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .sticky-atc__image { display: none; }
    .sticky-atc__btn { padding: 0.625rem 1rem; }
  }

  /* Variant Swatches */
  .swatch-group {
    margin-bottom: 1rem;
  }

  .swatch-group__label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .swatch-group__selected {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: #555;
  }

  .swatch-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .swatch {
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    position: relative;
    background: none;
    font-family: inherit;
  }

  .swatch:focus-visible {
    outline: 2px solid #667eea;
    outline-offset: 2px;
  }

  /* Color swatches */
  .swatch--color {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid rgba(0,0,0,0.15);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.3);
  }

  .swatch--color.is-selected {
    border-color: #667eea;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #667eea;
  }

  .swatch--color.is-unavailable {
    opacity: 0.35;
    cursor: not-allowed;
    position: relative;
  }

  .swatch--color.is-unavailable::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(to bottom right, transparent calc(50% - 1px), rgba(0,0,0,0.4) 50%, transparent calc(50% + 1px));
  }

  /* Label swatches (size, etc.) */
  .swatch--label {
    padding: 0.35rem 0.75rem;
    border: 2px solid rgba(0,0,0,0.12);
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-foreground);
    background: #fff;
    min-width: 40px;
    text-align: center;
  }

  .swatch--label.is-selected {
    border-color: #667eea;
    background: #667eea;
    color: #fff;
  }

  .swatch--label:hover:not(.is-unavailable):not(.is-selected) {
    border-color: #667eea;
    color: #667eea;
  }

  .swatch--label.is-unavailable {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }
{% endstylesheet %}

{% javascript %}
  class ProductPage {
    constructor() {
      this.form = document.querySelector('.product-form form');
      this.variantSelect = document.querySelector('#variant-select');
      this.quantityInput = document.querySelector('#quantity');
      this.submitButton = document.querySelector('[data-add-to-cart]');
      this.stickyBar = document.querySelector('[data-sticky-atc]');
      this.stickyBtn = document.querySelector('[data-sticky-atc-btn]');
      this.viewersEl = document.querySelector('[data-viewers]');
      this.init();
    }

    init() {
      if (!this.form) return;

      this.form.addEventListener('submit', (e) => this.handleSubmit(e));

      if (this.variantSelect) {
        this.variantSelect.addEventListener('change', (e) => this.handleVariantChange(e));
      }

      if (this.quantityInput) {
        this.quantityInput.addEventListener('change', (e) => this.handleQuantityChange(e));
      }

      this.initStickyAtc();
      this.initViewers();
    }

    handleSubmit(e) {
      if (!this.submitButton) return;
      this.submitButton.disabled = true;
      this.form.classList.add('form-submitting');
      const btnText = this.submitButton.querySelector('.btn-text');
      if (btnText) btnText.textContent = this.submitButton.dataset.textAdding || 'Adding...';
    }

    handleVariantChange(e) {
      const select = this.variantSelect;
      if (!select) return;
      const selectedOption = select.options[select.selectedIndex];
      const price = selectedOption ? parseInt(selectedOption.dataset.price) : 0;
      const available = selectedOption ? selectedOption.dataset.available !== 'false' : false;

      // Update price display
      const priceEl = document.querySelector('.product-price');
      if (priceEl && price) {
        const formatted = this.formatMoney(price);
        priceEl.textContent = formatted;
      }

      // Update ATC button state
      if (this.submitButton) {
        this.submitButton.disabled = !available;
        const btnText = this.submitButton.querySelector('.btn-text');
        if (btnText) {
          btnText.textContent = available
            ? (this.submitButton.dataset.textDefault || 'Add to Cart')
            : (this.submitButton.dataset.textSoldOut || 'Sold Out');
        }
      }

      // Update form-actions visibility
      const formActions = document.getElementById('product-form-actions');
      if (formActions) formActions.style.display = available ? '' : 'none';

      // Update sticky ATC price
      const stickyPrice = document.querySelector('.sticky-atc__price');
      if (stickyPrice && price) stickyPrice.textContent = this.formatMoney(price);

      // Fire custom event for volume discounts, etc.
      document.dispatchEvent(new CustomEvent('variant:change', { detail: { price: price, available: available } }));
    }

    formatMoney(cents) {
      if (window.Shopify && window.Shopify.money_format) {
        return window.Shopify.money_format
          .replace(/\{\{\s*amount\s*\}\}/, (cents / 100).toFixed(2))
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(cents / 100));
      }
      return (cents / 100).toFixed(2) + ' €';
    }

    handleQuantityChange(e) {
      const quantity = parseInt(e.target.value);
      if (quantity < 1) e.target.value = 1;
    }

    initStickyAtc() {
      if (!this.stickyBar || !this.submitButton) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const visible = !entry.isIntersecting;
          this.stickyBar.classList.toggle('is-visible', visible);
          this.stickyBar.setAttribute('aria-hidden', String(!visible));
        });
      }, { threshold: 0 });

      observer.observe(this.submitButton);

      if (this.stickyBtn) {
        this.stickyBtn.addEventListener('click', () => {
          this.submitButton.click();
        });
      }
    }

    initViewers() {
      if (!this.viewersEl) return;
      const min = parseInt(this.viewersEl.dataset.min) || 5;
      const max = parseInt(this.viewersEl.dataset.max) || 25;
      const count = Math.floor(Math.random() * (max - min + 1)) + min;
      const textEl = this.viewersEl.querySelector('[data-viewers-text]');
      if (textEl) {
        textEl.textContent = textEl.textContent.replace(/\d+/, count);
      }
    }

    initSwatches() {
      const swatches = document.querySelectorAll('[data-swatch-value]');
      const variantSelect = this.variantSelect;
      if (!swatches.length || !variantSelect) return;

      const variants = Array.from(variantSelect.options).map(opt => ({
        id: opt.value,
        title: opt.textContent.trim(),
        price: parseInt(opt.dataset.price) || 0,
        available: opt.dataset.available !== 'false'
      }));

      swatches.forEach(swatch => {
        swatch.addEventListener('click', () => {
          if (swatch.classList.contains('is-unavailable')) return;

          const optIdx = parseInt(swatch.dataset.optionIndex);
          const value  = swatch.dataset.swatchValue;

          // Update selected in group
          document.querySelectorAll(`.swatch-list [data-option-index="${optIdx}"]`).forEach(s => s.classList.remove('is-selected'));
          swatch.classList.add('is-selected');

          // Update label display
          const labelEl = document.getElementById('swatch-val-' + optIdx);
          if (labelEl) labelEl.textContent = value;

          // Build current selection across all option groups
          const currentOptions = {};
          document.querySelectorAll('.swatch.is-selected').forEach(s => {
            currentOptions[parseInt(s.dataset.optionIndex)] = s.dataset.swatchValue;
          });

          // Match variant
          const matched = variants.find(v => {
            const parts = v.title.split(' / ');
            return Object.keys(currentOptions).every(i => parts[i] === currentOptions[i]);
          });

          if (matched) {
            // Update hidden select
            Array.from(variantSelect.options).forEach(opt => {
              opt.selected = opt.value === matched.id;
            });
            variantSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const page = new ProductPage();
    page.initSwatches();
  });
{% endjavascript %}

