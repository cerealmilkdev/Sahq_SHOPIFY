[
  {
    "name": "theme_info",
    "theme_name": "Sahq",
    "theme_version": "1.0.0",
    "theme_author": "CEREALMILK",
    "theme_documentation_url": "https://github.com/Mandroso22/Sahq_SHOPIFY",
    "theme_support_url": "https://github.com/Mandroso22/Sahq_SHOPIFY/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "poppins_n4",
        "label": "t:general.heading_font",
        "info": "t:general.heading_font_info"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "roboto_n4",
        "label": "t:general.body_font",
        "info": "t:general.body_font_info"
      },
      {
        "type": "font_picker",
        "id": "type_accent_font",
        "default": "poppins_n6",
        "label": "t:general.accent_font",
        "info": "t:general.accent_font_info"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Shipping Progress Bar",
    "settings": [
      {
        "type": "header",
        "content": "Barre livraison gratuite"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Seuil livraison gratuite (€)",
        "info": "Montant en euros. 0 = désactivé.",
        "default": 50
      },
      {
        "type": "text",
        "id": "free_shipping_label",
        "label": "Message en cours",
        "default": "Plus que {amount} pour la livraison gratuite !"
      },
      {
        "type": "text",
        "id": "free_shipping_unlocked",
        "label": "Message débloqué",
        "default": "🎉 Livraison gratuite débloquée !"
      }
    ]
  },
  {
    "name": "Social Proof Toast",
    "settings": [
      {
        "type": "header",
        "content": "Notification d'achat récent"
      },
      {
        "type": "checkbox",
        "id": "sp_toast_enabled",
        "label": "Activer le Social Proof Toast",
        "default": true
      },
      {
        "type": "textarea",
        "id": "sp_toast_names",
        "label": "Noms & villes (un par ligne)",
        "default": "Sophie de Lyon\nLucas de Paris\nEmma de Bordeaux\nNoa de Marseille\nThéo de Lyon\nClara de Nantes\nMaxime de Toulouse\nLéa de Strasbourg\nJulie de Nice\nAntoine de Rennes"
      },
      {
        "type": "text",
        "id": "sp_toast_product_title",
        "label": "Titre produit (si hors page produit)",
        "default": "ce produit"
      },
      {
        "type": "range",
        "id": "sp_toast_first_delay",
        "min": 3,
        "max": 60,
        "step": 1,
        "unit": "s",
        "label": "Délai avant première notification",
        "default": 8
      },
      {
        "type": "range",
        "id": "sp_toast_interval",
        "min": 10,
        "max": 120,
        "step": 5,
        "unit": "s",
        "label": "Intervalle entre notifications",
        "default": 25
      }
    ]
  },
  {
    "name": "Upsell Modal",
    "settings": [
      {
        "type": "header",
        "content": "Modal upsell post-ATC"
      },
      {
        "type": "checkbox",
        "id": "upsell_enabled",
        "label": "Activer le modal upsell",
        "default": false,
        "info": "Le produit upsell est configuré depuis les paramètres de section Produit."
      },
      {
        "type": "text",
        "id": "upsell_pretitle",
        "label": "Pré-titre",
        "default": "Super choix !"
      },
      {
        "type": "text",
        "id": "upsell_title",
        "label": "Titre modal",
        "default": "Vous pourriez aussi aimer…"
      },
      {
        "type": "text",
        "id": "upsell_cta_yes",
        "label": "Bouton Oui",
        "default": "Oui, ajouter !"
      },
      {
        "type": "text",
        "id": "upsell_cta_no",
        "label": "Bouton Non",
        "default": "Non merci"
      }
    ]
  }
]
